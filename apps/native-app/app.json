{
  "expo": {
    "scheme": "studybet",
    "name": "StudyBet",
    "slug": "studybet-native-app",
    "version": "0.1.0",
    "icon": "./assets/studybet-icon.png",
    "splash": {
      "image": "./assets/studybet-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#243646"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoon1016.studybet",
      "infoPlist": {
        "NSCameraUsageDescription": "캠스터디 참여와 하루 공부 기록 영상을 위해 카메라 접근이 필요합니다.",
        "NSMicrophoneUsageDescription": "공부 세션 영상 기록에 필요한 오디오 수집을 위해 마이크 접근이 필요합니다."
      }
    },
    "android": {
      "package": "com.hoon1016.studybet",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "StudyBet 영상 저장을 위해 사진첩 접근을 허용해 주세요.",
          "savePhotosPermission": "StudyBet 영상 저장을 위해 사진첩에 추가를 허용해 주세요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StudyBet 챌린지 사진을 올리기 위해 사진 보관함 접근을 허용해 주세요."
        }
      ]
    ]
  }
}
